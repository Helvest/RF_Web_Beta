# This .gitignore file should be placed at the root of your Unity project directory

# ============
# Unity Engine
# ============
# Ignore Unity's generated folders and cache directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Ss]erverData/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ============
# Addressable Assets
# ============
# Packed addressable asset data (remove for release builds if you iterate on addressables)
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# ============
# Android Streaming Assets
# ============
# Temporary auto-generated Android asset metadata and files
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa.meta
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa/*

# ============
# Operating System Generated Files
# ============
# macOS system files
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows thumbnail cache files
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini

# ============
# Unity Asset Meta Data
# ============
# Only ignore .meta files for assets that are also ignored
!/[Aa]ssets/**/*.meta

# ============
# IDE - JetBrains Rider
# ============
# Ignore JetBrains Rider plugin files
[Aa]ssets/Plugins/Editor/JetBrains*

# Rider workspace and configuration files
.idea/
*.[Dd]ot[Ss]ettings

# ============
# IDE - Visual Studio
# ============
# Visual Studio cache and configuration directories
.vs/
.vsconfig

# ============
# IDE - Visual Studio Code
# ============
# VS Code workspace settings and extensions
.vscode/
*.code-workspace

# ============
# Build Tools
# ============
# Gradle build system cache
.gradle/

# ============
# Project Files Generated by IDEs
# ============
# Auto-generated solution and project files
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs

# ============
# Debug and Database Files
# ============
# Program database files and their metadata
*.pdb
*.opendb
*.VC.db

# System crash and error reports
sysinfo.txt
*.stackdump

# ============
# Build Artifacts
# ============
# Compiled mobile and package files
*.apk
*.unitypackage
*.aab
*.app

# ============
# Firebase Crashlytics
# ============
# Crashlytics configuration files
crashlytics-build.properties

# ============
# CMake Build System
# ============
# CMake temporary files
.utmp/