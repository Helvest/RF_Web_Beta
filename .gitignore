# This .gitignore file should be placed at the root of your Unity WebGL Build directory

# ============
# Operating System Generated Files
# ============
# macOS system files
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows thumbnail cache files
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini

# Rider workspace and configuration files
.idea/
*.[Dd]ot[Ss]ettings

# ============
# IDE - Visual Studio
# ============
# Visual Studio cache and configuration directories
.vs/
.vsconfig

# ============
# IDE - Visual Studio Code
# ============
# VS Code workspace settings and extensions
.vscode/
*.code-workspace
